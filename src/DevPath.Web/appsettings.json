{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Execution": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "ConcurrentPerUser": 1,
      "ConcurrencyRetryAfterSeconds": 2
    },
    "PasswordReset": {
      "PerEmailPermitLimit": 3,
      "PerEmailWindowMinutes": 60,
      "PerIpPermitLimit": 20,
      "PerIpWindowMinutes": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Execution": {
    "ResultTimeoutSeconds": 15
  },
  "Identity": {
    "PasswordResetTokenLifespan": "01:00:00",
    "SecurityStampValidationInterval": "00:01:00"
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Email": {
    "FromAddress": "nao-responda@devpath.local",
    "FromName": "DevPath",
    "Provider": "None",
    "Smtp": {
      "Host": "",
      "Port": 1025,
      "Security": "None",
      "Username": "",
      "TimeoutSeconds": 15
    },
    "Resend": {
      "BaseUrl": "https://api.resend.com",
      "TimeoutSeconds": 15
    }
  }
}
