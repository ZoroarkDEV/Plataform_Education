{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Execution": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "ConcurrentPerUser": 1,
      "ConcurrencyRetryAfterSeconds": 2
    }
  },
  "Execution": {
    "ResultTimeoutSeconds": 15
  }
}
