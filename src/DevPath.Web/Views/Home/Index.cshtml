@{
    ViewData["Title"] = "Início";
}

<section class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Bem-vindo ao DevPath</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Aprenda programação construindo de verdade
    </h1>
    <p class="mt-4 text-lg text-slate-600">
        Trilhas guiadas de C#, ASP.NET Core MVC, SQL e Docker, com exercícios práticos e progresso salvo.
    </p>
</section>

<section class="mt-10 grid gap-6 md:grid-cols-2" aria-labelledby="htmx-titulo">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 id="htmx-titulo" class="text-lg font-semibold text-slate-900">Exemplo de HTMX</h2>
        <p class="mt-2 text-sm text-slate-600">
            O botão faz um <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-xs">GET /Home/ServerTime</code>
            e o servidor devolve uma <em>partial view</em> que substitui só o quadro abaixo, sem recarregar a página.
        </p>

        <button type="button"
                hx-get="@Url.Action("ServerTime", "Home")"
                hx-target="#server-time"
                hx-swap="innerHTML"
                hx-indicator="#server-time-loading"
                class="mt-4 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
            Buscar horário do servidor
            <span id="server-time-loading" class="htmx-indicator text-xs" aria-hidden="true">…</span>
        </button>

        <div id="server-time" aria-live="polite"
             class="mt-4 rounded-lg border border-dashed border-slate-300 p-4 text-sm text-slate-500">
            Clique no botão para carregar o conteúdo via HTMX.
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Próximos passos</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600">
            <li>Criar sua conta e fazer login</li>
            <li>Escolher um objetivo de carreira</li>
            <li>Acompanhar seu progresso no dashboard</li>
        </ul>
    </div>
</section>
