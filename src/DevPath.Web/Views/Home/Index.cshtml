@{
    ViewData["Title"] = "Início";
    // US-11.1: um único botão principal. Visitante vai para o cadastro; quem já entrou vai para o
    // dashboard (que manda para "Escolha sua trilha" se ainda não houver trilha).
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="max-w-3xl" aria-labelledby="home-titulo">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">Bem-vindo ao DevPath</p>
    <h1 id="home-titulo" class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Aprenda programação construindo de verdade
    </h1>
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        Trilhas guiadas de C#, ASP.NET Core MVC, SQL e Docker, com exercícios práticos e progresso salvo.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        @if (signedIn)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn-primary px-6 py-3 text-base sm:w-auto">Começar Agora</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Register" class="btn-primary px-6 py-3 text-base sm:w-auto">Começar Agora</a>
            <p class="text-sm text-slate-600 dark:text-slate-300">
                Já tenho conta <span aria-hidden="true">→</span>
                <a asp-controller="Account" asp-action="Login" class="link">Entrar</a>
            </p>
        }
    </div>
</section>

<section class="mt-12" aria-labelledby="como-funciona">
    <h2 id="como-funciona" class="text-lg font-semibold text-slate-900 dark:text-white">Como funciona</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
        <li class="card p-5">
            <p class="text-sm font-semibold text-brand-700 dark:text-brand-300">Passo 1</p>
            <p class="mt-1 font-medium text-slate-900 dark:text-white">Crie sua conta</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Só nome, e-mail e senha.</p>
        </li>
        <li class="card p-5">
            <p class="text-sm font-semibold text-brand-700 dark:text-brand-300">Passo 2</p>
            <p class="mt-1 font-medium text-slate-900 dark:text-white">Escolha sua trilha</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Por exemplo, SQL &amp; Dados ou Backend .NET.</p>
        </li>
        <li class="card p-5">
            <p class="text-sm font-semibold text-brand-700 dark:text-brand-300">Passo 3</p>
            <p class="mt-1 font-medium text-slate-900 dark:text-white">Estude no seu ritmo</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">O dashboard mostra onde você parou.</p>
        </li>
    </ol>
</section>
