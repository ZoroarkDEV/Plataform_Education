@model DevPath.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Criar nova senha";
    const string passwordDescribedBy = "Password-hint";
}
@*
    #44 (US-AUTH.1). Mesmas regras e mensagens do cadastro; novalidate para a bolha do navegador
    (em inglês) não esconder as mensagens em pt-BR. UserId e Token vêm do link do e-mail.
*@
<div class="mx-auto max-w-md">
    <div class="card p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Criar nova senha</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Seu progresso e seus pontos continuam guardados.</p>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="mt-6 space-y-5" novalidate>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" autocomplete="new-password"
                       required minlength="8" maxlength="100"
                       pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+"
                       title="@DevPath.Web.ViewModels.Account.RegisterViewModel.PasswordRule"
                       aria-describedby="@passwordDescribedBy" />
                <p id="Password-hint" class="form-hint">@DevPath.Web.ViewModels.Account.RegisterViewModel.PasswordRule</p>
                <span asp-validation-for="Password" id="Password-error"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password"
                       required maxlength="100" />
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error"></span>
            </div>

            <button type="submit" class="btn-primary">Salvar senha nova</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
