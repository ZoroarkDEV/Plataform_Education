@model DevPath.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}
@*
    #44 (US-AUTH.1). Validação só no servidor (novalidate, como o cadastro): mensagens em pt-BR.
    O form tag helper gera o __RequestVerificationToken. A resposta é a mesma exista a conta ou não.
*@
<div class="mx-auto max-w-md">
    <div class="card p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Esqueci minha senha</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Informe o e-mail da sua conta. Vamos enviar um link para você criar uma senha nova.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="mt-6 space-y-5" novalidate>
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" autocomplete="email" inputmode="email"
                       autocapitalize="none" spellcheck="false" required maxlength="256" placeholder="voce@exemplo.com" />
                <span asp-validation-for="Email" id="Email-error"></span>
            </div>

            <button type="submit" class="btn-primary">Enviar link</button>
        </form>
    </div>

    <p class="mt-6 text-center text-sm text-slate-600 dark:text-slate-300">
        Lembrou a senha?
        <a asp-controller="Account" asp-action="Login" class="link inline-flex min-h-11 items-center">Entrar</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
