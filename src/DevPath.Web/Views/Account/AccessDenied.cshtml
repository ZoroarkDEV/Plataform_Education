@{
    ViewData["Title"] = "Acesso negado";
}
<section class="mx-auto max-w-md text-center" aria-labelledby="acesso-negado-titulo">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mx-auto grid size-12 place-items-center rounded-full bg-amber-100 text-amber-700" aria-hidden="true">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
        </div>
        <h1 id="acesso-negado-titulo" class="mt-4 text-2xl font-bold tracking-tight text-slate-900">Acesso negado</h1>
        <p class="mt-2 text-slate-600">Você não tem permissão para acessar esta página.</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn-primary sm:w-auto">Voltar para o dashboard</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-primary sm:w-auto">Entrar com outra conta</a>
            }
            <a asp-controller="Home" asp-action="Index" class="link self-center text-sm">Ir para o início</a>
        </div>
    </div>
</section>
