@{
    ViewData["Title"] = "Link inválido";
}
@* #44: link vencido, já usado ou adulterado. Mesma tela para todos os casos. *@
<div class="mx-auto max-w-md">
    <div class="card p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Link inválido</h1>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-200" role="alert">@DevPath.Web.Controllers.AccountController.LinkNoLongerValidMessage</p>
        <a asp-controller="Account" asp-action="ForgotPassword" class="btn-primary mt-6">Pedir um novo link</a>
    </div>
</div>
