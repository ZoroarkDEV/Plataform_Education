@model DevPath.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}
@*
    Validação: no servidor (Data Annotations + ModelState) e, no navegador, pelos atributos HTML5
    (required, minlength/maxlength, pattern, type="email"), que espelham o RegisterViewModel.
    "Confirmar senha" igual à senha só é checado no servidor ([Compare]).
*@
<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Criar conta</h1>
        <p class="mt-1 text-sm text-slate-600">Comece sua trilha e acompanhe seu progresso.</p>

        <form asp-controller="Account" asp-action="Register" method="post" class="mt-6 space-y-5">
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div>
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-input" autocomplete="name"
                       required minlength="2" maxlength="100" />
                <span asp-validation-for="DisplayName" id="DisplayName-error"></span>
            </div>

            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" autocomplete="email" inputmode="email"
                       autocapitalize="none" spellcheck="false" required maxlength="256" placeholder="voce@exemplo.com" />
                <span asp-validation-for="Email" id="Email-error"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" autocomplete="new-password"
                       required minlength="8" maxlength="100"
                       pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+"
                       title="Pelo menos 8 caracteres, com letra minúscula, letra maiúscula e número."
                       aria-describedby="Password-hint" />
                <p id="Password-hint" class="form-hint">Pelo menos 8 caracteres, com letra minúscula, letra maiúscula e número.</p>
                <span asp-validation-for="Password" id="Password-error"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password"
                       required maxlength="100" />
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error"></span>
            </div>

            <button type="submit" class="btn-primary">Criar conta</button>
        </form>
    </div>

    <p class="mt-6 text-center text-sm text-slate-600">
        Já tem conta?
        <a asp-controller="Account" asp-action="Login" class="link">Entrar</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
