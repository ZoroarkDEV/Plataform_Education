@model DevPath.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}
@* Markup mínimo e funcional. O Frontend Operator (#5/#9) vai estilizar com Tailwind:
   pode trocar classes e estrutura, mas mantenha os asp-for, o asp-validation-* e o <form method="post">
   (o form tag helper gera o token antiforgery). *@

<h1>Criar conta</h1>

<form asp-controller="Account" asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div>
        <label asp-for="DisplayName"></label>
        <input asp-for="DisplayName" autocomplete="name" />
        <span asp-validation-for="DisplayName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit">Criar conta</button>
</form>

<p>Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
