@{
    ViewData["Title"] = "Confira seu e-mail";
}
@* #44: mesma tela exista a conta ou não (não revela quais e-mails têm conta). *@
<div class="mx-auto max-w-md">
    <div class="card p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Confira seu e-mail</h1>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-200" role="status">@DevPath.Web.Controllers.AccountController.ForgotPasswordSentMessage</p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">O link vale por 1 hora e só pode ser usado uma vez.</p>
    </div>

    <p class="mt-6 text-center text-sm text-slate-600 dark:text-slate-300">
        Não chegou?
        <a asp-controller="Account" asp-action="ForgotPassword" class="link inline-flex min-h-11 items-center">Pedir outro link</a>
        <span aria-hidden="true">·</span>
        <a asp-controller="Account" asp-action="Login" class="link inline-flex min-h-11 items-center">Entrar</a>
    </p>
</div>
