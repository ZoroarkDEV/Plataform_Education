@using DevPath.Application.Analytics
@model AttemptsReport
@{
    ViewData["Title"] = "Tentativas (admin)";
    static string Lesson(AnalyticsLesson l) => $"{l.PathTitle} · {l.ModuleOrder}. {l.ModuleTitle} · Aula {l.LessonOrder}: {l.LessonTitle}";
    // Classes escritas por extenso (o Tailwind só gera o que encontra literal nas views).
    const string Th = "min-w-48 border-b border-slate-300 px-3 py-2 text-left font-semibold whitespace-nowrap dark:border-slate-600";
    const string ThNum = "border-b border-slate-300 px-3 py-2 text-right font-semibold whitespace-nowrap dark:border-slate-600";
    const string RowHead = "min-w-48 px-3 py-2 text-left font-medium";
    const string Td = "px-3 py-2 text-right tabular-nums whitespace-nowrap";
    const string Tr = "border-b border-slate-200 odd:bg-slate-50 dark:border-slate-700 dark:odd:bg-slate-800/50";
    static string Num(double? v) => v is null ? "—" : v.Value.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
}
@* #43. Só aulas visíveis aos alunos. SQL e definições: docs/analytics/tentativas.md *@
<h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Tentativas do Executar</h1>
<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Só aulas publicadas (sem rascunhos nem aulas ocultas). Tentativa = execução gravada; recusas (limite, código vazio, executor fora, erro de preparação) não contam.</p>

<section class="card mt-6 p-5 overflow-x-auto" aria-labelledby="ate-acertar">
    <h2 id="ate-acertar" class="text-lg font-semibold text-slate-900 dark:text-white">Quantas tentativas até acertar?</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Por aluno, tentativas até o primeiro acerto (inclusive). Quem ainda não acertou só entra em "Tentaram".</p>
    <table id="tabela-ate-acertar" class="mt-4 w-full border-collapse text-sm">
        <thead>
            <tr>
                <th scope="col" class="@Th">Aula</th><th scope="col" class="@ThNum">Tentaram</th><th scope="col" class="@ThNum">Acertaram</th>
                <th scope="col" class="@ThNum">Mediana</th><th scope="col" class="@ThNum">Média</th>
                <th scope="col" class="@ThNum">1</th><th scope="col" class="@ThNum">2</th><th scope="col" class="@ThNum">3</th><th scope="col" class="@ThNum">4</th><th scope="col" class="@ThNum">5</th>
                <th scope="col" class="@ThNum">6–10</th><th scope="col" class="@ThNum">11+</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.AttemptsUntilPass)
        {
            <tr class="@Tr" data-lesson-id="@r.Lesson.LessonId">
                <th scope="row" class="@RowHead">@Lesson(r.Lesson)</th><td class="@Td">@r.StudentsTried</td><td class="@Td">@r.StudentsPassed</td>
                <td class="@Td">@Num(r.MedianAttempts)</td><td class="@Td">@Num(r.AverageAttempts)</td>
                <td class="@Td">@r.Distribution.One</td><td class="@Td">@r.Distribution.Two</td><td class="@Td">@r.Distribution.Three</td><td class="@Td">@r.Distribution.Four</td>
                <td class="@Td">@r.Distribution.Five</td><td class="@Td">@r.Distribution.SixToTen</td><td class="@Td">@r.Distribution.ElevenOrMore</td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.AttemptsUntilPass.Count == 0)
    {
        <p class="mt-2 text-sm">Nenhuma aula com exercício.</p>
    }
</section>

<section class="card mt-6 p-5 overflow-x-auto" aria-labelledby="seguir-sem-pontos">
    <h2 id="seguir-sem-pontos" class="text-lg font-semibold text-slate-900 dark:text-white">Em qual aula mais gente usa "Seguir sem pontos"?</h2>
    <table id="tabela-seguir-sem-pontos" class="mt-4 w-full border-collapse text-sm">
        <thead>
            <tr><th scope="col" class="@Th">Aula</th><th scope="col" class="@ThNum">Usaram</th><th scope="col" class="@ThNum">Continuam sem pontos</th><th scope="col" class="@ThNum">Acertaram depois</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Skips)
        {
            <tr class="@Tr" data-lesson-id="@r.Lesson.LessonId">
                <th scope="row" class="@RowHead">@Lesson(r.Lesson)</th><td class="@Td">@r.StudentsSkipped</td><td class="@Td">@r.StillSkipped</td><td class="@Td">@r.PassedAfterSkip</td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Skips.Count == 0)
    {
        <p class="mt-2 text-sm">Ninguém usou o "Seguir sem pontos" ainda.</p>
    }
</section>

<section class="card mt-6 p-5 overflow-x-auto" aria-labelledby="taxa-falha">
    <h2 id="taxa-falha" class="text-lg font-semibold text-slate-900 dark:text-white">Taxa de falha por aula</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Tentativas que não passaram ÷ tentativas. "Sem detalhe" = falhas gravadas antes de separar errado de erro.</p>
    <table id="tabela-taxa-falha" class="mt-4 w-full border-collapse text-sm">
        <thead>
            <tr>
                <th scope="col" class="@Th">Aula</th><th scope="col" class="@ThNum">Tentativas</th><th scope="col" class="@ThNum">Alunos</th><th scope="col" class="@ThNum">Certas</th>
                <th scope="col" class="@ThNum">Erradas</th><th scope="col" class="@ThNum">Erro/timeout</th><th scope="col" class="@ThNum">Sem detalhe</th><th scope="col" class="@ThNum">Taxa de falha</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.FailureRates)
        {
            <tr class="@Tr" data-lesson-id="@r.Lesson.LessonId">
                <th scope="row" class="@RowHead">@Lesson(r.Lesson)</th><td class="@Td">@r.Attempts</td><td class="@Td">@r.Students</td><td class="@Td">@r.Passed</td>
                <td class="@Td">@r.Wrong</td><td class="@Td">@r.Errors</td><td class="@Td">@r.FailedWithoutDetail</td><td class="@Td">@r.FailureRatePercent.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))%</td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.FailureRates.Count == 0)
    {
        <p class="mt-2 text-sm">Nenhuma tentativa ainda.</p>
    }
</section>
