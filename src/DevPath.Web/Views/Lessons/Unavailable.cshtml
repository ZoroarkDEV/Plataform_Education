@model LessonUnavailableViewModel
@*
    Aula que não abre: não existe, rascunho, defeito, bloqueada (403) ou outra trilha (403).
*@
@{
    ViewData["SupportsDarkMode"] = true;
    var isMalformed = Model.Reason == LessonUnavailableReason.Malformed;
    var isDraft = Model.Reason == LessonUnavailableReason.Draft;
    var isLocked = Model.Reason == LessonUnavailableReason.Locked;
    var isOtherPath = Model.Reason == LessonUnavailableReason.OtherPath;
}
<section class="mx-auto max-w-xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8"
         aria-labelledby="titulo-indisponivel"
         data-lesson-unavailable="@Model.Reason">
    @if (isDraft)
    {
        <p class="mb-3 inline-block rounded-full border border-slate-400 px-2 text-xs font-semibold text-slate-700 dark:border-slate-500 dark:text-slate-300">Em breve</p>
    }
    <h1 id="titulo-indisponivel" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">@Model.Title</h1>
    <p class="mt-3 text-base text-slate-700 dark:text-slate-300" data-lesson-error>@Model.Message</p>

    <div class="mt-6 flex flex-wrap gap-3">
        @if (isLocked && Model.RequiredLessonTitle is not null)
        {
            @if (Model.RequiredLessonCanOpen && Model.RequiredLessonUrl is not null)
            {
                <a href="@Model.RequiredLessonUrl" class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300">
                    @LessonCompletionTexts.GoToRequired(Model.RequiredLessonTitle)
                </a>
            }
            else
            {
                <span class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:text-slate-200" aria-disabled="true">
                    @LessonCompletionTexts.GoToRequired(Model.RequiredLessonTitle)
                </span>
            }
            <a asp-controller="Dashboard" asp-action="Index" class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800">
                @LessonCompletionTexts.BackToPath
            </a>
        }
        else if (isOtherPath)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300">
                @LessonCompletionTexts.BackToPath
            </a>
        }
        else
        {
            @if (isMalformed)
            {
                <a href="@(Context.Request.Path)" class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800">Tentar de novo</a>
            }
            <a asp-controller="Dashboard" asp-action="Index" class="inline-flex min-h-11 w-full items-center justify-center sm:w-auto rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300">Voltar ao dashboard</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.TechnicalDetail))
    {
        <details class="mt-6 text-sm text-slate-700 dark:text-slate-300">
            <summary class="cursor-pointer font-medium focus-visible:outline-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300">Ver detalhe técnico</summary>
            <p class="mt-2 break-words font-mono">@Model.TechnicalDetail</p>
        </details>
    }
</section>
