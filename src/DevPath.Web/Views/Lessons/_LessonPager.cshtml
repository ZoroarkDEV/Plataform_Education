@using DevPath.Application.Lessons
@model LessonPageViewModel
@*
    "← Aula anterior" / "Próxima aula →". Rascunho (IsDraft) aparece como "Em breve", sem link
    (decisão do dono, R4: não abre e não bloqueia a navegação). Sem aula = espaço vazio.
    ViewData["PagerLabel"] diferencia as duas navegações (topo e fim) para leitores de tela.
*@
@{
    var lesson = Model.Lesson;
    var crumbs = lesson.Breadcrumb;
    var label = ViewData["PagerLabel"] as string ?? "Navegação entre aulas";

    string UrlFor(LessonLink link) =>
        Url.Action("Show", "Lessons", new { pathSlug = crumbs.PathSlug, moduleSlug = crumbs.ModuleSlug, lessonSlug = link.Slug })!;

    const string box = "flex min-h-14 flex-col justify-center rounded-lg border px-4 py-2 text-sm";
}
<nav aria-label="@label" class="grid grid-cols-2 gap-3">
    @foreach (var (link, isNext) in new[] { (lesson.PreviousLesson, false), (lesson.NextLesson, true) })
    {
        var direction = isNext ? "Próxima aula →" : "← Aula anterior";
        var align = isNext ? "items-end text-right col-start-2" : "items-start text-left col-start-1";

        if (link is null)
        {
            continue;
        }

        if (link.IsDraft)
        {
            <span class="@box @align border-dashed border-slate-300 bg-slate-100 text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-300"
                  aria-disabled="true">
                <span class="text-xs font-semibold">@direction</span>
                <span class="font-medium">@link.Title</span>
                <span class="mt-1 inline-block rounded-full border border-slate-400 px-2 text-xs font-semibold dark:border-slate-500">Em breve</span>
            </span>
        }
        else
        {
            <a href="@UrlFor(link)" rel="@(isNext ? "next" : "prev")"
               class="@box @align border-slate-300 bg-white text-slate-900 hover:border-brand-600 hover:bg-brand-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-brand-100 dark:hover:bg-slate-800">
                <span class="text-xs font-semibold text-brand-700 dark:text-brand-100">@direction</span>
                <span class="font-medium">@link.Title</span>
            </a>
        }
    }
</nav>
