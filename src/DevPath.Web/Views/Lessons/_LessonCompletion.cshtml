@using DevPath.Web.Progress
@model LessonCompletionViewModel
@*
    Bloco de conclusão (#27): botão / selo / "Seguir sem pontos" / mensagens.
    HTMX troca este bloco (#lesson-completion) e o pager via hx-swap-oob.
*@
@{
    var state = Model.State;
    var successId = "lesson-completion-success";
    var blockerId = "lesson-completion-blocker";
    var skipDescId = "lesson-skip-desc";
}
<div id="lesson-completion"
     class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800"
     data-conclusao-url="@Model.ConclusaoUrl"
     @* data-* com valor null ainda sai como data-x="" no Razor: por isso o atributo inteiro é condicional. *@
     @(state.CompletionKind is { } kind ? Html.Raw($"data-completion-kind=\"{kind}\"") : null)
     @(Model.MovesFocus ? Html.Raw("data-just-completed=\"true\"") : null)
     @(Model.Announces ? Html.Raw("data-announce=\"true\"") : null)>
    @* A região polite NÃO fica aqui (este bloco é trocado por outerHTML): é a #lesson-live estável do Show.cshtml. *@

    @if (Model.ShowBadge)
    {
        <div class="flex flex-wrap items-center gap-3">
            <partial name="_CompletedBadge" />
        </div>

        @if (Model.ModuleCompleted is { } moduleDone)
        {
            @* #42: no lugar da mensagem e do "Próxima aula →" (o pager OOB vem sem a próxima). *@
            <div class="mt-4">
                <partial name="_ModuleCompletion" model="moduleDone" view-data='new ViewDataDictionary(ViewData) { ["ModuleHeadingLevel"] = 2, ["ModuleInLesson"] = true }' />
            </div>
            @if (Model.ShowUnlockNotice)
            {
                <p class="mt-3 min-w-0 break-words text-base font-medium text-emerald-800 dark:text-emerald-200"
                   data-achievement-unlocked>
                    <span aria-hidden="true">@AchievementTexts.Medal</span>
                    @AchievementTexts.UnlockLead<strong>@Model.JustUnlocked!.Title</strong>@AchievementTexts.UnlockAfterTitle@Model.JustUnlocked.Description
                </p>
            }
        }
        else if (Model.SuccessMessage is { } msg)
        {
            var isInfo = !Model.JustPassed && state.CompletionKind is LessonCompletionKind.SkippedAfterFailures or LessonCompletionKind.AttemptsExhausted;
            <p id="@successId"
               tabindex="-1"
               class="mt-3 min-w-0 break-words text-base @(isInfo
                   ? "text-slate-800 dark:text-slate-200"
                   : "font-medium text-emerald-800 dark:text-emerald-200")"
               data-completion-message>
                @msg
                @if (Model.ShowUnlockNotice)
                {
                    @* Mesmo bloco focado/anunciado: o aviso entra no textContent, então o leitor ou o
                       #lesson-live anunciam uma vez só, junto da mensagem de +N pontos (QA #42). *@
                    <span class="mt-2 block" data-achievement-unlocked>
                        <span aria-hidden="true">@AchievementTexts.Medal</span>
                        @AchievementTexts.UnlockLead<strong>@Model.JustUnlocked!.Title</strong>@AchievementTexts.UnlockAfterTitle@Model.JustUnlocked.Description
                    </span>
                }
            </p>
        }
    }
    else if (Model.ShowButton)
    {
        <form method="post"
              action="@Model.CompleteUrl"
              hx-post="@Model.CompleteUrl"
              hx-target="#lesson-completion"
              hx-swap="outerHTML"
              hx-disabled-elt="find button[type=submit]"
              data-complete-form>
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn-primary inline-flex min-h-11 w-full items-center justify-center px-6 py-3 text-base sm:w-auto"
                    data-complete-button>
                <span data-label-idle>@LessonCompletionTexts.CompleteButton</span>
                <span data-label-busy class="hidden">@LessonCompletionTexts.Saving</span>
            </button>
        </form>
    }
    else if (Model.ShowDisabledExerciseButton)
    {
        <div>
            <button type="button"
                    class="btn-primary inline-flex min-h-11 w-full cursor-not-allowed items-center justify-center px-6 py-3 text-base opacity-60 sm:w-auto"
                    aria-disabled="true"
                    aria-describedby="@blockerId"
                    data-complete-button-locked>
                @LessonCompletionTexts.CompleteButton
            </button>
            <p id="@blockerId" class="mt-2 text-sm text-slate-700 dark:text-slate-300">
                @LessonCompletionTexts.ExerciseBlocker
            </p>
        </div>
    }

    @if (Model.ShowSkipButton)
    {
        <form method="post"
              action="@Model.CompleteUrl"
              hx-post="@Model.CompleteUrl"
              hx-target="#lesson-completion"
              hx-swap="outerHTML"
              hx-disabled-elt="find button[type=submit]"
              class="mt-4"
              data-skip-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="skipWithoutPoints" value="true" />
            <button type="submit"
                    class="inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800 sm:w-auto"
                    aria-describedby="@skipDescId"
                    data-skip-button>
                @LessonCompletionTexts.SkipButton
            </button>
            <p id="@skipDescId" class="mt-2 text-sm text-slate-700 dark:text-slate-300">
                @LessonCompletionTexts.SkipDescribedBy
            </p>
        </form>
    }

    @if (TempData[DevPath.Web.Controllers.LessonsController.FlashKey] is string flashErr
         && flashErr == LessonCompletionTexts.SaveError)
    {
        <p role="alert" class="mt-3 text-sm font-medium text-red-800 dark:text-red-200" data-completion-error>
            @flashErr
        </p>
    }
</div>

@if (ViewData["PagerOob"] as bool? == true && ViewData["LessonPage"] is LessonPageViewModel page)
{
    <div id="lesson-pager-end" hx-swap-oob="true">
        <partial name="_LessonPager" model="page" view-data='new ViewDataDictionary(ViewData) { ["PagerLabel"] = "Navegação entre aulas (fim da página)", ["PagerFocus"] = Model.MovesFocus, ["PagerHideNext"] = Model.ModuleCompleted is not null }' />
    </div>
}
