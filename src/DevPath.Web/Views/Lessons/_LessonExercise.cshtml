@model LessonExerciseViewModel
@*
    Exercício da aula com editor in-page e Executar (#30 B2).
    Visão segura: sem solução, test_cases nem common_errors.
    ExerciseId vem do gateway de progresso; sem Id o Executar não aparece (Pending).
*@
@{
    const string prose = "prose prose-slate max-w-none text-base dark:prose-invert prose-a:text-brand-700 dark:prose-a:text-brand-100 prose-code:rounded prose-code:bg-slate-200 prose-code:px-1 prose-code:py-0.5 prose-code:before:content-none prose-code:after:content-none dark:prose-code:bg-slate-800";
    var instruction = Model.InstructionText.Replace("**Executar**", "<strong>Executar</strong>");
    var attemptsId = "exercise-attempts";
    var execReasonId = "executar-disabled-reason";
    var exhausted = Model.AttemptsExhausted;
}
<section aria-labelledby="sec-exercicio"
         class="mt-10 rounded-lg border border-slate-300 p-5 dark:border-slate-700"
         data-exercise
         data-exercise-id="@(Model.ExerciseId?.ToString() ?? "")"
         data-max-attempts="@(Model.MaxAttempts?.ToString() ?? "")"
         data-remaining-attempts="@(Model.RemainingAttempts?.ToString() ?? "")"
         data-can-skip="@(Model.CanSkip ? "true" : "false")"
         data-failed-attempts="@Model.FailedAttempts">
    <h2 id="sec-exercicio" class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Exercício: @Model.Title</h2>
    <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-slate-700 dark:text-slate-300">
        <div class="flex gap-1"><dt>Linguagem:</dt><dd class="font-semibold">@Model.LanguageLabel</dd></div>
        @if (Model.DatasetDisplayName is not null)
        {
            <div class="flex gap-1" data-dataset>
                <dt>Dados usados:</dt>
                <dd class="font-semibold" data-dataset-name>@Model.DatasetDisplayName</dd>
            </div>
        }
        <div class="flex gap-1"><dt>Vale:</dt><dd class="font-semibold">@Model.PointsLabel</dd></div>
    </dl>

    <div class="@prose mt-4">@Html.Raw(Model.StatementHtml)</div>

    @if (Model.ExerciseId is not null)
    {
        <h3 class="mt-6 text-base font-semibold text-slate-900 dark:text-white">Editor</h3>
        <p class="text-sm text-slate-700 dark:text-slate-300">@Html.Raw(instruction)</p>

        <label for="exercise-code" class="sr-only">Sua consulta SQL</label>
        <textarea id="exercise-code"
                  name="code"
                  rows="10"
                  maxlength="20000"
                  spellcheck="false"
                  class="mt-3 w-full rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100"
                  data-exercise-code
                  @(exhausted ? "readonly" : null)>@Model.StarterCodePlain</textarea>

        <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
            <button type="button"
                    class="btn-primary inline-flex min-h-11 w-full items-center justify-center px-6 py-3 text-base sm:w-auto disabled:cursor-not-allowed disabled:opacity-60 aria-disabled:cursor-not-allowed aria-disabled:opacity-60"
                    data-execute-button
                    aria-describedby="@(exhausted ? execReasonId : (Model.MaxAttempts is not null ? attemptsId : null))"
                    @(exhausted ? "aria-disabled=true" : null)>
                <span data-execute-idle>@LessonCompletionTexts.ExecuteButton</span>
                <span data-execute-busy class="hidden">@LessonCompletionTexts.ExecuteLoading</span>
            </button>
            @if (Model.MaxAttempts is not null)
            {
                <p id="@attemptsId"
                   class="text-sm text-slate-700 dark:text-slate-300"
                   data-attempts-counter
                   aria-live="polite">
                    @if (Model.RemainingAttempts == 1)
                    {
                        @LessonCompletionTexts.LastAttempt
                    }
                    else if (Model.RemainingAttempts is { } rem)
                    {
                        @LessonCompletionTexts.RemainingAttempts(rem)
                    }
                </p>
            }
        </div>
        @if (exhausted)
        {
            <p id="@execReasonId" class="mt-2 text-sm text-slate-700 dark:text-slate-300" data-executar-reason>
                @LessonCompletionTexts.AttemptsExhaustedReason
            </p>
        }

        <div id="exercise-feedback" class="mt-4" data-exercise-feedback aria-live="polite"></div>
        <div id="exercise-results" class="mt-4 hidden" data-exercise-results></div>
    }
    else if (Model.StarterCodeHtml is not null)
    {
        <h3 class="mt-6 text-base font-semibold text-slate-900 dark:text-white">Código para começar</h3>
        <p class="text-sm text-slate-700 dark:text-slate-300">@Html.Raw(instruction)</p>
        @Html.Raw(Model.StarterCodeHtml)
    }

    @if (Model.Hints.Count > 0)
    {
        <h3 class="mt-6 text-base font-semibold text-slate-900 dark:text-white">Dicas</h3>
        <p class="text-sm text-slate-700 dark:text-slate-300">Tente sozinho primeiro. Abra uma dica de cada vez: a primeira é a mais geral.</p>
        <ol class="mt-3 space-y-2" data-hints>
            @for (var i = 0; i < Model.Hints.Count; i++)
            {
                <li data-hint>
                    <details name="dicas-exercicio" class="rounded-md border border-slate-300 bg-white px-4 dark:border-slate-600 dark:bg-slate-900">
                        <summary class="min-h-11 cursor-pointer py-3 font-medium text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-300 dark:text-slate-100">
                            Ver dica @(i + 1) de @Model.Hints.Count
                        </summary>
                        <p class="mt-2 pb-2 text-base text-slate-800 dark:text-slate-200">@Model.Hints[i]</p>
                    </details>
                </li>
            }
        </ol>
    }
</section>
