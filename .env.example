# Copie para .env e ajuste os valores. Nunca commite o arquivo .env.
# Valores abaixo são apenas exemplos para desenvolvimento local.

# PostgreSQL
POSTGRES_USER=devpath
POSTGRES_PASSWORD=change_me
POSTGRES_DB=devpath
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Aplicação (serviço web do docker-compose): porta no host -> http://localhost:8080
WEB_PORT=8080
# Development aplica as migrations e faz o seed de /content no startup do container.
ASPNETCORE_ENVIRONMENT=Development

# Connection string usada pela aplicação .NET e pelo `dotnet ef` (mesmos valores acima).
# Só para `dotnet run`/`dotnet ef` fora do Docker: o serviço web do compose monta a dele (Host=postgres).
# O .NET não lê este arquivo sozinho: exporte antes de rodar, ex. `set -a && . ./.env && set +a`.
ConnectionStrings__DevPath="Host=localhost;Port=5432;Database=devpath;Username=devpath;Password=change_me"

# Redis da fila de execução de exercícios (a Web enfileira, o Worker executa). Mesmo REDIS_PORT acima.
ConnectionStrings__Redis="localhost:6379"

# E-mail (#44): Mailpit, a caixa local de dev/staging. Interface: http://localhost:8025
# Em staging no mesmo host, use outro nome e outras portas (ex.: devpath-staging-mailpit, 1026, 8026).
MAILPIT_CONTAINER_NAME=devpath-mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_FROM_ADDRESS=nao-responda@devpath.local
# URL pública da Web: base dos links dos e-mails (nunca o header Host). Deve bater com WEB_PORT.
PUBLIC_BASE_URL=http://localhost:8080
